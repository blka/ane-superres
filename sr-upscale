#!/usr/bin/env zsh
# sr-upscale — video super-resolution via CoreML/ANE (Apple Silicon).
#
# Usage:
#   sr-upscale VIDEO [-o OUT] [-s HH:MM:SS] [-d DUR] [--target HxW]
#                  [--no-deint] [--bitrate 10M] [--model MODELS/av3x4_tensor.mlpackage]
#
# Pipeline: ffmpeg (optional bwdif+hqdn3d) -> sr_driver.py (ANE, x4)
#           -> bicubic 0.5 + crop/scale to target -> h264_videotoolbox, audio -c:a copy.
#
# Default target: 2x input size (H*2 x W*2). --target forces the output size
# (center-aligned: bicubic 0.5 first, then a centered crop/scale).
set -euo pipefail

VIDEO="" OUT="" START="" DUR="" TARGET="" DEINT=1 BITRATE="10M"
SCRIPT_DIR="${0:A:h}"
SELF="${0:A}"
MODEL="${SCRIPT_DIR}/models/av3x4_tensor.mlpackage"
PY="${SCRIPT_DIR}/.venv/bin/python"

# note: inside a zsh function $0 is the function name, not the script path
usage() { sed -n '2,12p' "$SELF"; exit 1; }
[[ $# -lt 1 ]] && usage

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) OUT="$2"; shift 2 ;;
    -s) START="$2"; shift 2 ;;
    -d) DUR="$2"; shift 2 ;;
    --target) TARGET="$2"; shift 2 ;;
    --no-deint) DEINT=0; shift ;;
    --bitrate) BITRATE="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) if [[ -z "$VIDEO" ]]; then VIDEO="$1"; shift; else echo "too many arguments: $1" >&2; exit 2; fi ;;
  esac
done

[[ -f "$VIDEO" ]] || { echo "no such file: $VIDEO" >&2; exit 2; }
[[ -d "$MODEL" ]] || { echo "model missing: $MODEL (run ./setup.sh)" >&2; exit 2; }

read W H FPS <<<"$(ffprobe -v error -select_streams v:0 \
  -show_entries stream=width,height,r_frame_rate \
  -of csv=p=0:s=x "$VIDEO" | head -1 | tr 'x' ' ')"

# input filter: deinterlace + denoise (SD sources) or passthrough
VF=""
if [[ $DEINT -eq 1 ]]; then
  VF="bwdif=mode=send_field,hqdn3d,"
fi

# output target
if [[ -n "$TARGET" ]]; then
  TH="${TARGET%x*}"; TW="${TARGET#*x}"
else
  TH=$((H * 2)); TW=$((W * 2))
fi

# after the model: W*4 x H*4; target is THxTW.
# out-scale = 2 -> bicubic 0.5 from x4; otherwise scale directly.
X4W=$((W * 4)); X4H=$((H * 4))
W2=$((W * 2)); H2=$((H * 2))
# ncnn "x2" semantics: x4 model -> bicubic 1/2 to W2xH2 -> centered crop to target
if (( TW == X4W && TH == X4H )); then
  OUTVF="setsar=1"
elif (( TW <= W2 && TH <= H2 )); then
  OUTVF="scale=${W2}:${H2}:flags=bicubic,crop=${TW}:${TH}:$(( (W2 - TW) / 2 )):$(( (H2 - TH) / 2 )),setsar=1"
else
  OUTVF="scale=${TW}:${TH}:flags=bicubic,setsar=1"
fi

[[ -n "$OUT" ]] || OUT="${VIDEO:r}_sr.mp4"

SSA=(); DURA=()
[[ -n "$START" ]] && SSA=(-ss "$START")
[[ -n "$DUR" ]] && DURA=(-t "$DUR")

echo "sr-upscale: $VIDEO (${W}x${H} @ ${FPS}) -> $OUT (${TW}x${TH}), model $MODEL" >&2

# bwdif=send_field doubles the frame rate (field -> frame)
if [[ $DEINT -eq 1 ]]; then
  FN="${FPS%%/*}"; FD="${FPS#*/}"
  FPS="$((FN * 2))/${FD}"
fi

ffmpeg -v error "${SSA[@]}" "${DURA[@]}" -i "$VIDEO" -vf "${VF}format=rgb24" \
  -f rawvideo -pix_fmt rgb24 - \
| "$PY" "${SCRIPT_DIR}/sr_driver.py" "$MODEL" "${W}x${H}" 2> >(grep -E 'DONE|model:|frame [0-9]*0000:' >&2) \
| ffmpeg -v error -y -f rawvideo -pix_fmt rgb24 -s ${X4W}x${X4H} -r "$FPS" -i - \
    "${SSA[@]}" "${DURA[@]}" -i "$VIDEO" \
    -vf "$OUTVF" -c:v h264_videotoolbox -b:v "$BITRATE" -pix_fmt yuv420p \
    -map 0:v -map '1:a?' -c:a copy -shortest "$OUT"

echo "done: $OUT" >&2